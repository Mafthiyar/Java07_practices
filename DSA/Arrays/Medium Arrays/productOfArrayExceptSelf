import java.util.*;
class solution {
    public static int[] productofArray(int[] arr){
        int[] r = new int[arr.length];
        int left = 1;
        int right = 1;

        for(int i=0; i<arr.length; i++){
             r[i] = left;
             left = left * arr[i];
        }

        for(int i=arr.length-1; i>=0; i--){
            r[i] *= right;
            right = right * arr[i];
        }
        return r;
    }
    public static void main(String[] args) {
    int arr[] = {1,2,3,4};
    int[] nums = productofArray(arr);

    for(int x : nums){
        System.out.print(x + " ");
    }
    }
}
